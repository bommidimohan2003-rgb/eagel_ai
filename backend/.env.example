# App Config
PROJECT_NAME="Personal AI Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Security & JWT
JWT_SECRET="dev-secret-key-nemotron-assistant-min-32-chars-long-abc-123"
JWT_REFRESH_SECRET="dev-refresh-secret-key-nemotron-assistant-min-32-chars-xyz-789"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database: MySQL Workbench
DATABASE_URL="mysql+aiomysql://root:Bmohan@localhost:3306/nemotron_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Configuration (NVIDIA Nemotron / OpenRouter)
NVIDIA_API_KEY=your-api-key-here
NVIDIA_BASE_URL="https://openrouter.ai/api/v1"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
DEFAULT_TEMPERATURE=0.6
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=4096

# Rate Limiting
RATE_LIMIT_PER_MINUTE="60/minute"
CHAT_RATE_LIMIT="30/minute"
